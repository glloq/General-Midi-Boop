{
  "server": {
    "port": 8080,
    "wsPort": 8080,
    "staticPath": "./public"
  },
  "midi": {
    "bufferSize": 1024,
    "sampleRate": 44100,
    "defaultLatency": 10
  },
  "database": {
    "path": "./data/gmboop.db",
    "busyTimeoutMs": 250
  },
  "logging": {
    "level": "info",
    "file": "./logs/gmboop.log",
    "console": true
  },
  "playback": {
    "defaultTempo": 120,
    "defaultVolume": 100,
    "lookahead": 100,
    "handShiftCompensation": false
  },
  "latency": {
    "defaultIterations": 5,
    "recalibrationDays": 7
  },
  "ble": {
    "enabled": false,
    "scanDuration": 10000
  },
  "serial": {
    "enabled": false,
    "autoDetect": true,
    "baudRate": 31250,
    "ports": []
  },
  "network": {
    "rtpMidiPort": 5004
  },
  "security": {
    "mode": "trusted-lan"
  },
  "transcription": {
    "enabled": true,
    "dataDir": "./data/transcription",
    "maxAudioFileBytes": 104857600,
    "maxAudioDurationSeconds": 600,
    "maxParallelJobs": 1,
    "maxTempDiskBytes": 2147483648,
    "jobTimeoutMs": 900000,
    "keepOriginalAudio": false,
    "keepTempFiles": false,
    "postProcessingPreset": "balanced",
    "availabilityCacheMs": 60000,
    "autoImportToLibrary": true
  }
}
