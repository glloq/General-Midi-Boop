# Général Midi Boop Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server
# PORT=8080
# GMBOOP_SERVER_PORT=8080
# GMBOOP_SERVER_WS_PORT=8080

# Database
# GMBOOP_DATABASE_PATH=./data/gmboop.db

# Logging
# GMBOOP_LOG_LEVEL=info
# GMBOOP_LOG_FILE=./logs/gmboop.log

# Bluetooth
# GMBOOP_BLE_ENABLED=false

# Serial
# GMBOOP_SERIAL_ENABLED=false
# GMBOOP_SERIAL_BAUD_RATE=31250

# Network (RTP-MIDI)
# Fixed UDP port every RTP-MIDI session listens on (so peers can reach the box).
# GMBOOP_RTP_MIDI_PORT=5004

# Network test devices (development only). Set to 1/true to inject synthetic
# "test" instruments into scan results when nothing real is discovered.
# GMBOOP_NETWORK_TEST_DEVICES=0

# Security mode
# trusted-lan (default): same-origin SPA + RFC1918/loopback clients skip the
# bearer token. secure: require the token for EVERY non-public request (use on
# shared/untrusted networks).
# GMBOOP_SECURITY_MODE=trusted-lan

# Authentication
# Un token aléatoire est généré automatiquement au premier démarrage et sauvegardé
# dans .env. Vous pouvez le remplacer par une valeur personnalisée si besoin.
# GMBOOP_API_TOKEN=votre-token-secret-ici

# Audio -> MIDI transcription (optional feature)
# The engines themselves are installed separately; GMB starts and runs
# normally with none of them present.
# GMBOOP_TRANSCRIPTION_ENABLED=true
# GMBOOP_TRANSCRIPTION_DATA_DIR=./data/transcription
# Resource guards — tuned for a Raspberry Pi; raise them on a desktop.
# GMBOOP_TRANSCRIPTION_MAX_AUDIO_BYTES=104857600
# GMBOOP_TRANSCRIPTION_MAX_AUDIO_SECONDS=600
# GMBOOP_TRANSCRIPTION_MAX_PARALLEL_JOBS=1
# GMBOOP_TRANSCRIPTION_MAX_TEMP_BYTES=2147483648
# GMBOOP_TRANSCRIPTION_JOB_TIMEOUT_MS=900000
# Keep the uploaded audio file after the MIDI has been imported.
# GMBOOP_TRANSCRIPTION_KEEP_AUDIO=false
# Keep per-job scratch directories instead of deleting them (debugging).
# GMBOOP_TRANSCRIPTION_KEEP_TEMP=false
